# Global default for text files to handle line endings automatically.
* text=auto

# Enforce LF line endings on checkouts for bash scripts, profiles, services, config, and documentation.
*.sh text eol=lf
*.profile text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.env text eol=lf
*.md text eol=lf

*.ps1 text

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
